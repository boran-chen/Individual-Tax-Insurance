# 会话签名密钥（32 字节以上随机串）
APP_SESSION_SECRET=
# 敏感字段加密密钥（base64 编码的 32 字节）
APP_ENCRYPTION_KEY=
# 证件号等值匹配指纹密钥（32 字节以上随机串）
APP_ID_HASH_KEY=
# 初始化管理员
ADMIN_LOGIN=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=集团管理员
# 上传限制
MAX_UPLOAD_MB=50
MAX_ROWS=200000
# 生产环境默认 Secure Cookie；本地 http 预览可设为 0
# COOKIE_SECURE=0
