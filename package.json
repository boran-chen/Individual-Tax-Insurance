{
  "name": "cbr-commission-tax",
  "version": "1.0.0",
  "private": true,
  "description": "保险代理人佣金个税申报数据管理系统",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup": "npm run compile:scripts && node dist-scripts/scripts/setup.js",
    "compile:scripts": "tsc -p tsconfig.scripts.json",
    "db:seed": "npm run compile:scripts && node dist-scripts/scripts/seed.js",
    "generate:sample": "npm run compile:scripts && node dist-scripts/scripts/generate-sample.js",
    "perf": "npm run compile:scripts && node dist-scripts/scripts/perf.js",
    "smoke": "npm run compile:scripts && node dist-scripts/scripts/smoke.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
